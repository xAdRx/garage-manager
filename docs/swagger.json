{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Basic Go REST API.",
        "title": "REST API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/vehicles": {
            "get": {
                "description": "Returns all vehicles. Every filter is optional; filters combine with AND.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "vehicles"
                ],
                "summary": "List vehicles",
                "parameters": [
                    {
                        "enum": [
                            "car",
                            "motorcycle"
                        ],
                        "type": "string",
                        "description": "Vehicle type",
                        "name": "type",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Brand, case-insensitive exact match",
                        "name": "brand",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Model, case-insensitive exact match",
                        "name": "model",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Exact production year",
                        "name": "year",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Production year from (inclusive)",
                        "name": "minYear",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Production year to (inclusive)",
                        "name": "maxYear",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/handlers.VehicleDoc"
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid filter value",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.VehicleDoc": {
            "type": "object",
            "properties": {
                "brand": {
                    "type": "string",
                    "example": "Volkswagen"
                },
                "doors": {
                    "description": "only when type is car",
                    "type": "integer",
                    "example": 5
                },
                "hasSidecar": {
                    "description": "only when type is motorcycle",
                    "type": "boolean",
                    "example": false
                },
                "id": {
                    "type": "string",
                    "format": "uuid",
                    "example": "3f2b8c1e-9d4a-4e6b-8a7f-1c2d3e4f5a6b"
                },
                "model": {
                    "type": "string",
                    "example": "Golf"
                },
                "type": {
                    "enum": [
                        "car",
                        "motorcycle"
                    ],
                    "allOf": [
                        {
                            "$ref": "#/definitions/models.VehicleType"
                        }
                    ],
                    "example": "car"
                },
                "year": {
                    "type": "integer",
                    "example": 2020
                }
            }
        },
        "models.VehicleType": {
            "type": "string",
            "enum": [
                "car",
                "motorcycle"
            ],
            "x-enum-varnames": [
                "TypeCar",
                "TypeMotorcycle"
            ]
        }
    }
}