{
    "schemes": [
        "http",
        "https"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Basic Go REST API.",
        "title": "REST API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/cars": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "cars"
                ],
                "summary": "Get cars",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Car"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "models.Car": {
            "type": "object",
            "properties": {
                "brand": {
                    "type": "string",
                    "example": "Volkswagen"
                },
                "doors": {
                    "type": "integer",
                    "example": 5
                },
                "id": {
                    "type": "string",
                    "format": "uuid",
                    "example": "3f2b8c1e-9d4a-4e6b-8a7f-1c2d3e4f5a6b"
                },
                "model": {
                    "type": "string",
                    "example": "Golf"
                },
                "year": {
                    "type": "integer",
                    "example": 2020
                }
            }
        }
    }
}